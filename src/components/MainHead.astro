---
import Analytics from '../components/functions/Analytics.astro';
import { socialLinks, authorInfo, siteName } from '../data/content';
import '../styles/layout.scss';
import '../styles/global.scss';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
	image?: string | undefined;
	imageAlt?: string | undefined;
	type?: 'website' | 'article' | undefined;
	person?: boolean | undefined;
	articleData?: {
		publishDate?: string;
		modifiedDate?: string;
		author?: string;
		tags?: string[];
		section?: string;
		faq?: { q: string; a: string }[];
	} | undefined;
}

const {
	title,
	description,
	keywords,
	image = '/og-image.png',
	imageAlt,
	type = 'website',
	person = false,
	articleData,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://senlinpubu.top';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const fullTitle = title ? `${title}` : siteName;
const ogImageAlt = imageAlt || title || siteName;
const sameAs = socialLinks.filter((s) => s.url.startsWith('http')).map((s) => s.url);
const authorName = articleData?.author || authorInfo.name;
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteName} href={new URL("rss.xml", Astro.site)} />

<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="generator" content={Astro.generator} />
<meta name="author" content={authorInfo.name} />
<meta name="baidu-site-verification" content="codeva-LSnHZRk2TW" />
<meta name="bytedance-verification-code" content="Q4WDJOIrszITWeHPvbGW" />
<title>{fullTitle}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.png" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

{/* ── Open Graph ── */}
<meta property="og:type" content={person ? 'profile' : type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="zh_CN" />
{type === 'article' && articleData?.publishDate && (
	<meta property="article:published_time" content={articleData.publishDate} />
)}
{type === 'article' && articleData?.modifiedDate && (
	<meta property="article:modified_time" content={articleData.modifiedDate} />
)}
{type === 'article' && articleData?.author && (
	<meta property="article:author" content={articleData.author} />
)}
{type === 'article' && articleData?.section && (
	<meta property="article:section" content={articleData.section} />
)}
{type === 'article' && articleData?.tags?.map(tag => (
	<meta property="article:tag" content={tag} />
))}

{/* ── Twitter Card ── */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{/* ── JSON-LD: WebSite ── */}
{type === 'website' && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": siteName,
		"url": siteUrl,
		"description": description,
		"inLanguage": "zh-CN",
		"publisher": {
			"@type": "Person",
			"name": authorInfo.name,
			"url": siteUrl + "/about/"
		}
	})} />
)}

{/* ── JSON-LD: Person（关于页）── */}
{type === 'article' && person && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		"name": authorInfo.name,
		"alternateName": authorInfo.alternateName,
		"url": canonicalUrl,
		"description": description,
		"jobTitle": authorInfo.jobTitle,
		"email": `mailto:${authorInfo.email}`,
		"sameAs": sameAs,
		"knowsAbout": authorInfo.knowsAbout
	})} />
)}

{/* ── JSON-LD: BlogPosting ── */}
{type === 'article' && !person && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"headline": fullTitle,
		"description": description,
		"image": ogImageUrl,
		"url": canonicalUrl,
		"datePublished": articleData?.publishDate,
		"dateModified": articleData?.modifiedDate || articleData?.publishDate,
		"inLanguage": "zh-CN",
		"articleSection": articleData?.section,
		"author": {
			"@type": "Person",
			"name": authorName,
			"url": siteUrl + "/about/",
			"sameAs": sameAs
		},
		"publisher": {
			"@type": "Person",
			"name": authorInfo.name,
			"url": siteUrl
		},
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalUrl
		},
		"isPartOf": {
			"@type": "Blog",
			"name": siteName,
			"url": siteUrl + "/blog/"
		},
		"about": (articleData?.tags || []).map(tag => ({ "@type": "Thing", "name": tag })),
		"keywords": (articleData?.tags || []).join(", ")
	})} />
)}

{/* ── JSON-LD: FAQPage ── */}
{type === 'article' && !person && articleData?.faq && articleData.faq.length > 0 && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": articleData.faq.map(({ q, a }) => ({
			"@type": "Question",
			"name": q,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": a
			}
		}))
	})} />
)}

{/* ── JSON-LD: BreadcrumbList for articles ── */}
{type === 'article' && !person && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{
				"@type": "ListItem",
				"position": 1,
				"name": "首页",
				"item": siteUrl
			},
			{
				"@type": "ListItem",
				"position": 2,
				"name": "博客",
				"item": siteUrl + "/blog/"
			},
			{
				"@type": "ListItem",
				"position": 3,
				"name": fullTitle,
				"item": canonicalUrl
			}
		]
	})} />
)}

<script is:inline>
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');

	if (typeof localStorage !== 'undefined') {
		// Watch the document element and persist user preference when it changes.
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('theme-dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>

<Analytics />
