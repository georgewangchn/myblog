---
const gaId = import.meta.env.PUBLIC_GA4_ID;
const UMAMIId = import.meta.env.PUBLIC_UMAMI_ID;
// 百度统计 ID：优先读环境变量，未配置时回退到站点默认 ID（公开非密）
const baiduId = import.meta.env.PUBLIC_BAIDU_ID || '7b85d8cf7047e5ec75aed3bca6459784';
// const gaId = ''; 

if (!gaId) {
    //console.warn("Google Analytics ID (PUBLIC_GA4_ID) is missing!");
}

if (!UMAMIId) {
    //console.warn("Umami ID (PUBLIC_UMAMI_ID) is missing!");
}
---

<!-- GA4 跟踪代码 -->
{gaId && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} ></script>
    <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
    </script>
)}

<!-- UMAMIId 跟踪代码 -->
{UMAMIId && (
    <script
        is:inline
        async
        defer
        data-website-id={UMAMIId}
        src="https://cloud.umami.is/script.js"
    ></script>
)}

<!-- 百度统计 跟踪代码 -->
<!-- 注意：ID 必须在构建时烤进脚本源码（set:html），不能用运行时变量拼接。
     百度验证爬虫只抓 HTML 源码做字符串匹配，看不到 JS 执行后的 URL。 -->
{baiduId && (
    <script is:inline set:html={`var _hmt = _hmt || [];
(function() {
    var hm = document.createElement("script");
    hm.src = "https://hm.baidu.com/hm.js?${baiduId}";
    var s = document.getElementsByTagName("script")[0];
    s.parentNode.insertBefore(hm, s);
})();`} />
)}

<!-- Vercount 访问量计数器（前端公开展示用） -->
<script is:inline defer src="https://events.vercount.one/js"></script>
