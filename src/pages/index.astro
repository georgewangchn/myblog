---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from '../components/Cards.astro';
import Banner from '../components/Banner.astro';
import {homeTdk} from '../data/content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<BaseLayout
    title={homeTdk.title || ''}
    description={homeTdk.description || ''}
    keywords={homeTdk.keywords || ''}
>
    {/* ── 最新博客 ── */}
    <section class="section-blog-feed">
        <div class="container">
            <div class="blog-feed-card">
                <div class="blog-feed-card__header">
                    <span class="blog-feed-card__label">最新文章</span>
                    <a href="/blog/" class="blog-feed-card__more">更多 →</a>
                </div>
                <div class="blog-feed-card__list">
                    {latestPosts.map((post) => (
                        <a href={`/blog/${post.id}/`} class="blog-feed-card__item">
                            <span class="blog-feed-card__title">{post.data.title}</span>
                            <span class="blog-feed-card__date">{post.data.publishDate.toISOString().slice(5, 7)}-{post.data.publishDate.toISOString().slice(8, 10)}</span>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </section>

    {/* ── 专栏 Banner ── */}
    <section class="section-book">
        <div class="container">
            <Banner href="/book/index.html" target="_self">
                <div slot="media" class="banner-media-book">
                    <img src="/assets/cover/book-cover.png" alt="当LLM不够用了" loading="lazy" />
                </div>
                <div slot="info">
                    <span class="banner-tag">专栏</span>
                    <h2 class="banner-title">「当LLM不够用了」系列</h2>
                    <p class="banner-desc">
                        这个系列系统讲解如何用本体推理技术解决企业决策中的知识表示与自动推理问题。<br />
                        从 OWL 公理体系、SWRL 规则到 HermiT 推理引擎，从理论到 12 章完整实战 — 完整在线阅读。<br />
                        <strong>本体推理 ≠ 知识图谱。推理能力才是本体的灵魂。</strong>
                    </p>
                </div>
                <span slot="cta">在线阅读 →</span>
            </Banner>
        </div>
    </section>

    {/* ── GovernanceOps Demo ── */}
    <section class="section-demo">
        <div class="container">
            <Banner href="/demo/index.html" target="_blank">
                <div slot="media" class="banner-media-demo">
                    <img src="/assets/cover/governanceops-demo.png" alt="GovernanceOps Demo" loading="lazy" />
                    <span class="demo-play">▶</span>
                </div>
                <div slot="info">
                    <span class="banner-tag">演示视频</span>
                    <h2 class="banner-title">GovernanceOps Demo</h2>
                    <p class="banner-desc">
                        企业治理运维 —— 用本体推理替代人工流转，让决策从"人人负责、无人负责"的主观人治，<br />
                        推向可验证、可追踪、可审计的机制治。OWL + SWRL + HermiT 推理引擎驱动。
                    </p>
                </div>
                <span slot="cta">观看演示 →</span>
            </Banner>
        </div>
    </section>

    {/* ── OntologyOps 开源项目 ── */}
    <section class="section-projects">
        <div class="container">
            <Banner href="https://github.com/georgewangchn/OntologyOps" target="_blank">
                <div slot="media" class="banner-media-icon">
                    <svg viewBox="0 0 80 80" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="40" cy="40" r="34"/>
                        <path d="M26 40h28M40 26v28"/>
                        <circle cx="40" cy="40" r="14" stroke-dasharray="3 3"/>
                    </svg>
                </div>
                <div slot="info">
                    <span class="banner-tag">开源项目</span>
                    <h2 class="banner-title">OntologyOps</h2>
                    <p class="banner-desc">
                        本体即代码 — CI/CD for Knowledge。<br />
                        让本体像代码一样被管理，让知识像软件一样持续交付。版本化本体管理 + 自动推理验证。
                    </p>
                </div>
                <span slot="cta">GitHub →</span>
            </Banner>
        </div>
    </section>

    {/* ── 多范式推理实战 ── */}
    <section class="section-practice">
        <div class="container">
            <div class="section-label">
                <span class="section-label__tag">PRACTICE</span>
                <h2 class="section-label__title">多范式推理实战</h2>
                <p class="section-label__desc">
                    同一个诊断问题，四种推理范式 — 不为比较优劣，只为理解每种范式的思维方式与适用边界。
                </p>
            </div>
            <Cards />
        </div>
    </section>

    {/* ── 访问统计 ── */}
    <section class="section-stats">
        <div class="container">
            <div class="stats-card">
                <div class="stats-card__label">访问统计</div>
                <div class="stats-card__grid">
                    <div class="stats-card__item">
                        <span class="stats-card__value" id="vercount_value_site_pv">—</span>
                        <span class="stats-card__name">总访问量</span>
                    </div>
                    <div class="stats-card__item">
                        <span class="stats-card__value" id="vercount_value_site_uv">—</span>
                        <span class="stats-card__name">访客数</span>
                    </div>
                    <div class="stats-card__item">
                        <span class="stats-card__value" id="vercount_value_page_pv">—</span>
                        <span class="stats-card__name">本页浏览</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

</BaseLayout>

<style lang="scss">
/* ── Section rhythm: uniform vertical spacing ── */
.section-blog-feed {
    padding: 32px 0 0;
}
.section-book,
.section-demo,
.section-projects,
.section-practice {
    padding: 24px 0;
}
.section-stats {
    padding: 0 0 48px;
}

/* ── Latest Blog Feed ── */
.blog-feed-card {
    background: linear-gradient(135deg, var(--color-900), var(--color-999));
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    padding: 20px 28px;
    transition: border-color 0.3s ease;
    &:hover {
        border-color: var(--accent-regular);
    }
    &__label {
        display: block;
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--color-400);
        font-family: var(--font-type);
    }
    &__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }
    &__more {
        font-size: 0.85rem;
        color: var(--color-300);
        text-decoration: none;
        transition: color 0.2s ease;
        &:hover {
            color: var(--accent-regular);
        }
    }
    &__list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    &__item {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        text-decoration: none;
        color: var(--color-100);
        padding: 6px 0;
        transition: color 0.2s ease;
        &:hover {
            color: var(--accent-regular);
        }
    }
    &__title {
        font-size: 0.9rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }
    &__date {
        flex-shrink: 0;
        font-size: 12px;
        font-family: var(--font-type);
        color: var(--color-400);
        letter-spacing: 0.5px;
    }
}

/* ── Banner media specifics ── */
.banner-media-book {
    width: 140px;
    img {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }
}
.banner-media-demo {
    position: relative;
    width: 200px;
    img {
        width: 100%;
        height: 112px;
        object-fit: cover;
    }
}
.demo-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    opacity: 0.85;
    transition: all 0.3s ease;
}
.banner-card:hover .demo-play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
}
.banner-card:hover .banner-media-book img,
.banner-card:hover .banner-media-demo img {
    transform: scale(1.03);
}
.banner-media-icon {
    flex-shrink: 0;
    color: var(--color-400);
    transition: all 0.4s ease;
    padding: 0 8px;
}
.banner-card:hover .banner-media-icon {
    color: var(--accent-regular);
    transform: rotate(90deg);
}
@media (max-width: 768px) {
    .banner-media-book {
        width: 120px;
        img { height: 165px; }
    }
    .banner-media-icon {
        display: none;
    }
}

/* ── Section Label ── */
.section-label {
    text-align: center;
    margin: 48px 0 32px;
    &__tag {
        display: inline-block;
        font-size: 12px;
        letter-spacing: 1.5px;
        font-family: var(--font-type);
        color: var(--color-300);
        margin-bottom: 8px;
    }
    &__title {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--color-100);
        margin-bottom: 8px;
    }
    &__desc {
        font-size: 0.875rem;
        color: var(--color-300);
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.6;
    }
}

/* ── Practice Section ── */
.section-practice {
    padding: 24px 0 48px;
}

/* ── Visitor Stats ── */
.section-stats {
    padding: 0 0 48px;
}
.stats-card {
    background: linear-gradient(135deg, var(--color-900), var(--color-999));
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    padding: 28px 32px;
    text-align: center;
    transition: border-color 0.3s ease;
    &:hover {
        border-color: var(--accent-regular);
    }
    &__label {
        display: block;
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--color-400);
        font-family: var(--font-type);
        margin-bottom: 18px;
    }
    &__grid {
        display: flex;
        justify-content: center;
        gap: 48px;
        flex-wrap: wrap;
    }
    &__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }
    &__value {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--accent-regular);
        font-family: var(--font-type);
        line-height: 1.2;
        min-width: 1.5em;
    }
    &__name {
        font-size: 0.8rem;
        color: var(--color-300);
        letter-spacing: 0.5px;
    }
}
@media (max-width: 480px) {
    .stats-card {
        padding: 20px 16px;
        &__grid {
            gap: 24px;
        }
        &__value {
            font-size: 1.4rem;
        }
    }
}

/* ── Responsive ── */
@media (max-width: 768px) {
    .blog-feed-card {
        padding: 16px 20px;
        &__item {
            flex-direction: column;
            gap: 2px;
            padding: 4px 0;
        }
    }
}
</style>
