---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectList from '../components/ProjectList.astro';
import {pageTag, pageDescription,projectTdk} from '../data/content';
import { projectItems } from '../data/project';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://senlinpubu.top';
const softwareList = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: '开源项目 — 森林瀑布',
	itemListElement: projectItems.map((p, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'SoftwareSourceCode',
			name: p.title,
			alternateName: p.title_en,
			description: p.description,
			url: p.url,
			codeRepository: p.url && p.url.startsWith('https://github.com') ? p.url : undefined,
			keywords: (p.tags || []).join(', '),
			author: {
				'@type': 'Person',
				name: '森林瀑布',
				url: `${siteUrl}/about/`,
			},
		},
	})),
};
---

<BlogPostLayout
		title={projectTdk.title || ''}
		description = {projectTdk.description || ''}
		keywords = {projectTdk.keywords || ''}
>
	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
			tag={pageTag.project}
			description={pageDescription.project}>
				项目
			</SectionHeader>
			<section class="border-top">
				<div class="posts">
					<div class="posts-container">
							<ProjectList  />
					</div>
				</div>
			</section>
		</main>
	</div>

	<script type="application/ld+json" set:html={JSON.stringify(softwareList)} />
</BlogPostLayout>


<style>
	.posts{
		margin-top:24px;
	}
</style>