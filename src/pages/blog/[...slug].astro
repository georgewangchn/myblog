---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { matchTopics } from "../../data/topics";
interface Props {
	entry: CollectionEntry<'blog'>;
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
	const blog = await getCollection('blog');
	const sorted = blog.sort(
		(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
	);
	return sorted.map((entry, i) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: sorted[i + 1] ?? null,
			next: sorted[i - 1] ?? null,
		},
	}));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const articleData = {
	publishDate: entry.data.publishDate.toISOString(),
	modifiedDate: (entry.data.updatedDate ?? entry.data.publishDate).toISOString(),
	author: '森林瀑布',
	tags: entry.data.tags,
	section: entry.data.category,
	faq: entry.data.faq,
};
const relatedTopics = matchTopics({ id: entry.id, tags: entry.data.tags, category: entry.data.category });
---

<BlogPostLayout
	title={entry.data.title}
	description={entry.data.description}
	image={entry.data.img}
	articleData={articleData}
>
	<div class="post article">
		<main class="post-wrapper">
			<div class="section-header">
				<div class="row">
					<div class="section-content col-1a">
						<div class="section-title">
							<div class="title-tag">
								Article
							</div>
							<h1 class="title">
								{entry.data.title}
							</h1>
						</div>
					</div>

				</div>
				<div class="post-line post-line-bottom text-center" >
					<span class="text-center">更新于：{(entry.data.updatedDate ?? entry.data.publishDate).toISOString().slice(0,10)}</span>
					{
						entry.data.read &&   <span class="" >•</span>
					<span >{entry.data.read} min read</span>
					}
				</div>
				{
					entry.data.tags && entry.data.tags.length > 0 && (
						<div class="post-tags">
							{entry.data.tags.map((tag) => (
								<span class="post-tag">{tag}</span>
							))}
						</div>
					)
				}
			</div>

			{
				(entry.data.summary || entry.data.description) && (
					<div class="post-summary">
						<span class="post-summary__label">一句话总结</span>
						<p>{entry.data.summary ?? entry.data.description}</p>
					</div>
				)
			}

			<section>
				<div class="content">
					<Content />
				</div>
			</section>

			{
				entry.data.faq && entry.data.faq.length > 0 && (
					<section class="post-faq">
						<h2>常见问题（FAQ）</h2>
						{entry.data.faq.map(({ q, a }) => (
							<details class="post-faq__item">
								<summary>{q}</summary>
								<p>{a}</p>
							</details>
						))}
					</section>
				)
			}

			{
				relatedTopics.length > 0 && (
					<div class="post-topics">
						<span class="post-topics__label">相关主题</span>
						{relatedTopics.map((t) => (
							<a href={`/topic/${t.slug}/`}>{t.title}</a>
						))}
					</div>
				)
			}

			<div class="post-line post-line-views text-center">
				<span>本文阅读量 <span id="vercount_value_page_pv">—</span> 次</span>
			</div>

			<nav class="post-prevnext" aria-label="文章导航">
				{prev ? (
					<a class="prevnext prevnext--prev" href={`/blog/${prev.id}/`}>
						<span class="prevnext__label">← 上一篇</span>
						<span class="prevnext__title">{prev.data.title}</span>
					</a>
				) : <span class="prevnext prevnext--empty" />}
				{next ? (
					<a class="prevnext prevnext--next" href={`/blog/${next.id}/`}>
						<span class="prevnext__label">下一篇 →</span>
						<span class="prevnext__title">{next.data.title}</span>
					</a>
				) : <span class="prevnext prevnext--empty" />}
			</nav>

			<div class="post-back">
				<a href="/blog/">← 返回博客列表</a>
			</div>

		</main>
	</div>

	{
		toc.length >= 3 && (
			<aside class="toc" aria-label="目录">
				<div class="toc__title">目录</div>
				<ul>
					{toc.map((h) => (
						<li class:list={[{ 'toc__item--h3': h.depth === 3 }]}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ul>
			</aside>
		)
	}

</BlogPostLayout>

<style>


	.section-content{
		text-align:center;
	}
	.section-desc{
		text-align:center
	}
	.post-line-top{
		border-top: 1px dashed var(--color-700);
		padding-top: .5rem;
		padding-bottom: 2rem;
		margin-top: .5rem;
		font-size: .875rem;
		white-space: nowrap;
		color:var(--color-500);
		font-weight:300
	}
	.post-line-bottom{
		border-bottom: 1px dashed var(--color-700);
		padding-bottom: .5rem;
		margin:1.25rem auto 2.5rem;
		font-size: .8rem;
		color:var(--color-300);
	}
	.post-line-views{
		border-top: 1px dashed var(--color-700);
		padding-top: .75rem;
		margin: 1.5rem auto 0;
		font-size: .8rem;
		color:var(--color-300);
	}
	.post-line-views span span {
		color: var(--accent-regular);
		font-weight: 500;
	}
	.title-tag{
		display: inline-block;
		font-size: 13px;
		line-height: 1;
		margin:16px auto 24px;
		border:1px solid var(--color-700);
		border-radius: 36px;
		padding:8px 22px 4px;
		color: var(--color-300);
		text-align: center;
		font-family: var(--font-type);
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	.title{
		line-height: 1.2;
		margin: 0.5rem 0;
		color: var(--color-100);
		text-align: center;
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.description {
		font-size: var(--text);
	}

	.content {
		position:relative;
		color:var(--color-200);
		margin:3rem auto;
		max-width: 44rem;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.75em 0 1em;
		color:var(--color-100);
	}
	.content :global(h3){
		font-size: 1.5rem;
		color:var(--color-100);
	}
	.content :global(h4){
		font-size: 1.25rem;
		color:var(--color-200);
	}
	.content :global(h5){
		font-size: 1rem;
		color:var(--color-300);
	}
	.content :global(img) {
		border-radius: 8px;
	}

	.content :global(p) {
		margin:16px 0;
		line-height:1.8
	}
	.content :global(ol) {
		padding-left: 2em;
    margin: 2em 0;
	}
@media(max-width:850px){
	.post-wrapper{
		padding: 0 1.25rem;
	}
	.title-tag{
		font-size:12px;
	}
}
@media(max-width:376px){
	.post-wrapper{
		padding: 0 1rem;
	}
}
.action-back{
	display:none;
}
@media(min-width:767px){
	.action-back{
		position:fixed;
		display:block;
		top:74px;
		left:5%;
		background:var(--color-999);
	}
}
.article a:link{
	color:var(--color-blue);
}

/* ── Tags ── */
.post-tags{
	display:flex;
	flex-wrap:wrap;
	justify-content:center;
	gap:0.5rem;
	margin:0 auto 1.5rem;
}
.post-tag{
	font-size:0.75rem;
	line-height:1;
	padding:6px 14px 4px;
	border:1px solid var(--color-700);
	border-radius:36px;
	color:var(--color-300);
	font-family:var(--font-type);
}

/* ── Answer-first summary ── */
.post-summary{
	max-width:44rem;
	margin:0 auto 2rem;
	padding:1.25rem 1.5rem;
	border:1px solid var(--color-700);
	border-left:3px solid var(--accent-regular);
	border-radius:var(--radius-large);
	background:var(--color-900);
}
.post-summary__label{
	display:block;
	font-size:0.7rem;
	letter-spacing:1.5px;
	text-transform:uppercase;
	color:var(--accent-regular);
	font-family:var(--font-type);
	margin-bottom:0.5rem;
}
.post-summary p{
	margin:0;
	font-size:0.95rem;
	line-height:1.8;
	color:var(--color-200);
}

/* ── FAQ ── */
.post-faq{
	max-width:44rem;
	margin:2.5rem auto 0;
}
.post-faq h2{
	font-size:1.4rem;
	color:var(--color-100);
	margin-bottom:1rem;
}
.post-faq__item{
	border:1px solid var(--color-700);
	border-radius:var(--radius-large);
	padding:0.75rem 1.25rem;
	margin-bottom:0.75rem;
}
.post-faq__item summary{
	cursor:pointer;
	font-weight:600;
	color:var(--color-100);
}
.post-faq__item p{
	margin:0.75rem 0 0;
	line-height:1.8;
	color:var(--color-200);
}

/* ── Related topics ── */
.post-topics{
	max-width:44rem;
	margin:2rem auto 0;
	display:flex;
	flex-wrap:wrap;
	align-items:center;
	gap:0.5rem;
}
.post-topics__label{
	font-size:0.75rem;
	color:var(--color-400);
	font-family:var(--font-type);
}
.post-topics a{
	font-size:0.8rem;
	padding:5px 12px 4px;
	border:1px solid var(--color-700);
	border-radius:36px;
	color:var(--color-300);
	text-decoration:none;
}
.post-topics a:hover{
	border-color:var(--accent-regular);
	color:var(--accent-regular);
}

/* ── Prev / Next ── */
.post-prevnext{
	display:flex;
	gap:1rem;
	margin:2.5rem auto 0;
	max-width:44rem;
}
.prevnext{
	flex:1;
	display:flex;
	flex-direction:column;
	gap:6px;
	padding:1rem 1.25rem;
	border:1px solid var(--color-700);
	border-radius:var(--radius-large);
	text-decoration:none;
	transition:border-color .25s ease;
	&:hover{
		border-color:var(--accent-regular);
	}
}
.prevnext--next{
	text-align:right;
}
.prevnext--empty{
	border:none;
	pointer-events:none;
}
.prevnext__label{
	font-size:0.75rem;
	color:var(--color-300);
	font-family:var(--font-type);
}
.prevnext__title{
	font-size:0.9rem;
	color:var(--color-100);
	line-height:1.5;
	display:-webkit-box;
	-webkit-line-clamp:2;
	-webkit-box-orient:vertical;
	overflow:hidden;
}

/* ── Back link ── */
.post-back{
	text-align:center;
	margin:2rem auto 0;
	a{
		font-size:0.85rem;
		color:var(--color-300);
		text-decoration:none;
		&:hover{
			color:var(--accent-regular);
		}
	}
}

/* ── TOC（桌面端悬浮） ── */
.toc{
	display:none;
}
@media(min-width:1200px){
	.toc{
		display:block;
		position:fixed;
		top:120px;
		left:calc(50% + 26rem);
		width:16rem;
		max-height:70vh;
		overflow-y:auto;
		font-size:0.8rem;
	}
	.toc__title{
		font-family:var(--font-type);
		font-size:0.75rem;
		letter-spacing:1.5px;
		text-transform:uppercase;
		color:var(--color-300);
		margin-bottom:0.75rem;
	}
	.toc ul{
		list-style:none;
		margin:0;
		padding:0;
	}
	.toc li{
		margin:0;
		padding:0;
	}
	.toc li.toc__item--h3{
		padding-left:1rem;
	}
	.toc li a{
		display:block;
		padding:4px 0;
		color:var(--color-300);
		text-decoration:none;
		line-height:1.5;
		transition:color .2s ease;
	}
	.toc li a:hover{
		color:var(--accent-regular);
	}
}
@media(max-width:1199px){
	.toc{ display:none; }
}
</style>
